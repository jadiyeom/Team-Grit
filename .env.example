# Copy to .env; never commit real API keys.
TEAMGRIT_DATA_DIR=./data
TEAMGRIT_DEFAULT_PROVIDER=openai
TEAMGRIT_FAST_MODEL=gpt-4o-mini
TEAMGRIT_QUALITY_MODEL=gpt-4o
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=anthropic/claude-3-5-sonnet-latest
GEMINI_API_KEY=
GEMINI_MODEL=gemini/gemini-2.5-flash
OPENAI_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=
CUSTOM_MODEL=openai-compatible/model
LOCAL_BASE_URL=http://localhost:11434/v1
LOCAL_API_KEY=local
LOCAL_MODEL=openai/local-model
MANIM_DOCKER_IMAGE=manimcommunity/manim:stable
