# Copy to .env; never commit real API keys.
TEAMGRIT_DATA_DIR=./data
TEAMGRIT_DEFAULT_PROVIDER=openai

# OpenAI model defaults (verified against the public model catalog 2026-10-09)
TEAMGRIT_FAST_MODEL=gpt-6-luna
TEAMGRIT_QUALITY_MODEL=gpt-6.1-sol
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna

# Anthropic (LiteLLM model IDs use the anthropic/ prefix)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=anthropic/claude-sonnet-5

# Google Gemini (LiteLLM model IDs use the gemini/ prefix)
GEMINI_API_KEY=
GEMINI_MODEL=gemini/gemini-3.8-flash

# Any OpenAI-compatible API endpoint
OPENAI_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=
CUSTOM_MODEL=openai-compatible/model

# Local OpenAI-compatible inference server (for example, Ollama)
LOCAL_BASE_URL=http://localhost:11434/v1
LOCAL_API_KEY=local
LOCAL_MODEL=openai/local-model

MANIM_DOCKER_IMAGE=manimcommunity/manim:stable
